# ai-gateway configuration: copy to .env and edit. Lines starting with # are
# optional and show the default. Blank values count as unset.

# Address to listen on (the Docker image sets 0.0.0.0; keep this commented out there).
# HOST=127.0.0.1
# Port to listen on.
# PORT=8080
# Log format: text or json.
# LOG_FORMAT=text
# Log filter, e.g. info, or info,access=warn to quiet the access log.
# RUST_LOG=info

# required: generate with openssl rand -hex 32
GATEWAY_API_KEYS=
# Admin keys (comma-separated) can also read everyone's stats.
# ADMIN_API_KEYS=
# Requests per minute per key; also the burst size.
# RATE_LIMIT_RPM=60
# Largest accepted request body in bytes (10 MiB); bigger bodies get a 413.
# MAX_REQUEST_BYTES=10485760

# Upstreams clients pick with a model prefix, e.g. ollama/gemma4:e2b (required).
UPSTREAMS=ollama,openai
# Upstream for model names without a known prefix.
DEFAULT_UPSTREAM=ollama

# <NAME>_BASE_URL is required per upstream and includes the version path.
OLLAMA_BASE_URL=http://localhost:11434/v1
# <NAME>_FALLBACK (upstream/model) answers when this upstream is down or overloaded.
OLLAMA_FALLBACK=openai/gpt-6-terra

# The OpenAI API; any OpenAI-compatible backend works the same way.
OPENAI_BASE_URL=https://api.openai.com/v1
# <NAME>_API_KEY is sent to that upstream as Authorization: Bearer <key>.
OPENAI_API_KEY=sk-your-key-here

# Azure OpenAI without a key: uncomment this block and add azure to UPSTREAMS.
# AZURE_BASE_URL=https://my-resource.openai.azure.com/openai/v1
# azure_cli signs in with your az login; in Azure use managed_identity.
# AZURE_AUTH=azure_cli
# Client ID of a user-assigned managed identity; unset means the system-assigned one.
# AZURE_CLIENT_ID=
# Your deployment names, which /v1/models lists instead of asking Azure.
# AZURE_MODELS=my-gpt4o,my-gpt5-mini
# The scope tokens are requested for.
# AZURE_TOKEN_SCOPE=https://ai.azure.com/.default

# Seconds to wait for a connection to an upstream.
# UPSTREAM_CONNECT_TIMEOUT_SECS=10
# Longest silence allowed while waiting for upstream data, in seconds.
# UPSTREAM_TIMEOUT_SECS=300
# Where stats are saved (the Docker image uses /data/stats.json; keep this commented out there).
# STATS_PATH=stats.json
# How often stats are saved, in seconds (they're also saved on shutdown).
# STATS_FLUSH_SECS=60
